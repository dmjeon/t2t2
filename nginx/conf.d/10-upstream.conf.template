# =============================================================================
# 업스트림 — install/30-web.sh 가 __PLACEHOLDER__ 를 config.env 값으로 치환해
#            /etc/nginx/conf.d/10-upstream.conf 로 설치한다.
#
# ★ WEB 은 로컬 L4 VIP **하나만** 호출한다. WAS 선택에 관여하지 않는다.
#   교차(backup) 멤버로 넘길지 말지는 전적으로 L4 가 정한다.
#   그래서 WAS 장애가 GSLB 전환으로 번지지 않는다 (AADC-POC.md 1절 원칙).
# =============================================================================

upstream was_pool {
    server __L4_VIP__:8000 max_fails=2 fail_timeout=5s;
    keepalive 32;
}

# /health/local 전용 — L4 를 우회해 **로컬 WAS 를 직접** 본다.
# 실패 = "backup 으로 넘어가 있다" = 사람이 WAS 를 고쳐야 한다는 신호.
# GSLB 는 이 경로를 보지 않는다 (AADC-POC.md 4절).
upstream was_local_direct {
    server __WAS_LOCAL_IP__:8000 max_fails=0;
    keepalive 4;
}

# 교차(backup) 멤버만 담은 점검 전용 가상 서버 (AADC-POC.md 3-3절).
# backup 멤버는 평시 트래픽이 0 이라 검증되지 않는다. 장애 순간에야
# 동작 여부를 알게 되는 것을 막으려고 둔다. C13 판정에 쓴다.
upstream was_check_vs {
    server __CHECK_VS_VIP__:8000 max_fails=0;
}

# 반대편 DC 의 WEB — 검증 화면이 양쪽을 나란히 보여 주기 위한 경유로.
# 브라우저 CORS 를 피하려고 nginx 가 대신 물어본다. 서비스 트래픽이 아니다.
upstream peer_web {
    server __PEER_WEB_IP__:80 max_fails=0;
}
