# =============================================================================
# /etc/nginx/conf.d/acl-health.inc — 헬스체크 접근 제어
#
# /health/deep 응답에는 writer 호스트명과 read_only 상태가 들어 있다.
# 이걸 봐야 하는 것은 GSLB(DMZ FortiADC)와 모니터링뿐이다.
#
# ★ 여기서 GSLB 주소를 빠뜨리면 헬스체크가 403 이 되고,
#   GSLB 가 그 DC 를 빼 버린다. 배포 후 반드시 200 을 확인할 것.
#
# ★ 2026-09-21 — PoC 기간 한정으로 HEALTH_ALLOW="all" 이다. 아래가
#   `allow all;` 한 줄로 생성되면 그게 정상이며, 제한이 사라졌다는 뜻이다.
#   경위와 되돌리는 법은 config.env 의 HEALTH_ALLOW 주석에 있다.
# =============================================================================
__HEALTH_ALLOW_LINES__
deny all;
