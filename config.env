# =============================================================================
# AADC PoC 트랙 C — 공통 파라미터  (PoC 실값)
# =============================================================================
# 모든 설치/검증 스크립트가 이 파일을 source 한다.
#
# <<TBD>> 로 표시된 값은 AADC-POC.md 13-2절 "회신 대기" 항목이다.
# 값이 들어오기 전에는 해당 계층을 확정으로 취급하지 않는다.
#
# -----------------------------------------------------------------------------
# WHY THIS FILE IS COMMITTED AS-IS, WITH REAL VALUES
#
#   This is a throwaway PoC environment that will be torn down. Every credential
#   below is named `delete_20261013_*` so that the name itself states what it is:
#   a temporary secret that dies with the environment on 2026-10-13. Nothing here
#   is reused in production, and the environment it unlocks will not exist.
#
#   Keeping the real values in the bundle is a deliberate trade: the servers are
#   reachable only through a VM console (no inbound SSH, no jump host), so every
#   value typed by hand is a value typed wrong. We would rather ship the file.
#
#   DO NOT carry this file forward. If this PoC turns into anything permanent,
#   regenerate every credential and remove config.env from version control
#   (the .gitignore comment says the same thing).
#
#   On teardown, drop the accounts outright:
#     DROP USER 'aadc_app'@'10.3.21.%', 'aadc_app'@'10.7.21.%',
#               'repl'@'10.3.31.%', 'repl'@'10.7.31.%',
#               'monitor'@'127.0.0.1', 'monitor'@'10.3.%', 'monitor'@'10.7.%',
#               'aadc_hb'@'127.0.0.1', 'aadc_hb'@'localhost',
#               'aadc_dump'@'localhost';
# -----------------------------------------------------------------------------
# =============================================================================

# ----- 이 호스트가 무엇인가 -------------------------------------------------
# ★ 비워 둔다. 기본값을 두지 않는 것이 의도다.
#
#   값을 하나 박아 두면 7대 중 6대에서 틀린 값이 되고, IP 자동감지가 실패했을 때
#   그 틀린 값이 조용히 이긴다. "WAS 로 보인다"는 사고가 그렇게 난다.
#   비어 있으면 대신 **에러로 멈추고** 무엇을 줘야 하는지 알려 준다.
#
#   역할은 이 순서로 정해진다 (앞이 이김):
#     1) 인자          ./install/10-db.sh DB-MASTER
#     2) 환경변수      AADC_ROLE=DB-MASTER ./install/10-db.sh
#     3) IP 자동감지   아래 서버 IP 표와 대조 — 평소에는 이것만으로 충분하다
#     4) 이 값         비워 두면 3)까지 실패했을 때 에러
#
#   임시 주소로 설치 중이면 3)이 실패하는 것이 정상이다. 1)로 넘겨라.
#
# WEB-DC1 | WEB-DC2 | WAS-APP1-500 | WAS-DC2 | DB-MASTER | DB-BACKUP | DB-DR
AADC_ROLE=""
# AADC_DC 는 적지 않는다. 역할에서 유도한다 (install/lib.sh).
# 둘을 따로 적게 하면 서로 어긋난 채로 설치되는 사고가 난다.

# ----- 서버 IP (AADC-POC.md 2-1절, 단일 NIC) --------------------------------
WEB_DC1_IP="10.3.11.51"
WEB_DC2_IP="10.7.11.52"
WAS_DC500_IP="10.3.21.51"          # WAS-APP1-500
WAS_DC400_IP="10.7.21.52"          # WAS-DC2  (IP 할당 필요)

DB_VIP="10.3.31.50"                # keepalived VIP (DC-500 내부)
DB_MASTER_IP="10.3.31.51"
DB_BACKUP_IP="10.3.31.53"          # 신규 VM 필요
DB_DR_IP="10.7.31.52"              # dr-db 로 이전 필요 (현재 10.3.31.52)

# ----- 게이트웨이 (keepalived 타이브레이커 = 증인) --------------------------
GW_DC_DB="10.3.31.254"
GW_DC_APP="10.3.21.254"
GW_DR_APP="10.7.21.254"
GW_DC_WEB="10.3.11.254"
GW_DR_WEB="10.7.11.254"

# ----- 내부 L4 FortiADC VIP --------------------------------------------------
# ★ 2026-09-24 — 두 DC 모두 장비에서 직접 확인했다.
#     DC-500  dc-internal-fortiadc-01 (10.3.20.231)  VS 10.3.20.100:8000
#     DC-400  dr-internal-fortiadc-01 (10.7.20.231)  VS 10.7.20.100:8000
#   (09-22 트러블슈팅 때 DC-400 에서 본 VS 는 10.7.20.230 이었다. 지금은 .100 이다.)
#
#   DC-400 세부 (2026-09-22 확인)
#     SNAT 풀   app-snat-pool   10.7.20.250   (port1)
#     멤버 풀   was-app-pool    10.7.21.52 (로컬) · 10.7.21.51 (원격 = WAS-APP1 2번째 NIC)
#   DC-500 멤버 풀              10.3.21.51 (로컬) · 10.3.21.52 (원격 = WAS-DC2 2번째 NIC)
#   ※ 지금은 2NIC(확장 L2) 기준 시험이다. 라우팅 기반 단일 NIC 으로 바꾸면
#     원격 멤버가 10.3.21.51 / 10.7.21.52 (peer-routing 경유)로 바뀐다.
#     예정 작업 — NETWORK.md 3-4-1절.
#
#   ★★ SNAT 풀은 처음에 10.7.20.232 였다. 그 주소는 **옆 유닛
#     `dr-internal-fortiadc-02` 의 물리 IP** 다 (NETWORK.md 5-1절). 서버가
#     돌려보낸 SYN/ACK 가 옆 유닛으로 들어가 RST 로 끊겼고, WEB 에서는
#     연결 타임아웃만 보였다.
#
#     이게 왜 찾기 어려웠나 — 헬스체크는 SNAT 풀이 아니라 **인터페이스
#     IP(10.7.20.231)** 에서 나간다. 그래서 헬스체크는 멀쩡히 통과하고
#     VS 는 계속 healthy 인데 **실트래픽만 죽는다.** 화면상 정상이다.
#
#     DC-500 도 `dc-internal-fortiadc-02` 가 10.3.20.232 다 — 같은 함정이다.
#     SNAT 풀에 .231/.232 를 쓰지 말 것. DC-400 과 맞춰 .250 을 쓴다.
DC500_L4_VIP="10.3.20.100"         # 확인됨 2026-09-24 (장비에서 직접)
DC400_L4_VIP="10.7.20.100"         # 확인됨 2026-09-24 (장비에서 직접)
# backup(교차) 멤버 점검 전용 VS — AADC-POC.md 3-3절
# ★ 이 VS 는 아직 장비에서 확인되지 않았다. DC-400 장비에 있던 Virtual Server
#   는 `was-virtal-server` 하나뿐이었다. 없으면 /checkvs/ 는 계속 실패하고,
#   검증 화면은 "backup 멤버 무응답" 으로 표시한다 (web/assets/app.js).
#   아래 두 값은 자리표시자다 — 실제로 만들 때 주소를 맞출 것.
DC500_CHECK_VS_VIP="10.3.20.101"   # <<TBD>>  멤버: 10.7.21.52 만
DC400_CHECK_VS_VIP="10.7.20.101"   # <<TBD>>  멤버: 10.3.21.51 만
L4_PORT="8000"

# ----- 업스트림 모드 --------------------------------------------------------
#   l4      본설계. WEB → 로컬 L4 VIP → WAS   (Full NAT, backup 멤버 포함)
#   direct  임시. WEB → 로컬 WAS 직결. L4 를 건너뛴다.
#
# ★ direct 는 내부 L4 FortiADC 가 꺼져 있는 동안만 쓰는 임시 구성이다.
#   이 모드에서는 아래가 **검증되지 않는다**. 되는 것처럼 보여도 아니다.
#     · Full NAT(SNAT) 동작            — C12
#     · L4 backup 멤버 흡수            — C15 (WAS 장애가 곧 DC 장애가 된다)
#     · L4 장비 장애 감지              — C18 (deep check 의 유일한 단독 근거)
#     · via_l4 로 경유 DC 판정         — 5-1절
#   L4 가 올라오면 반드시 l4 로 되돌리고 위 항목을 다시 돌린다.
#
# ★ 2026-09-22 — l4 로 되돌렸다. 네트워크 팀이 내부 L4 FortiADC 의 VIP 를
#   잡는 중이고, 그 작업을 확인할 화면으로 WAS:8000 에 /l4test 를 올렸다.
#
#   ※ 이 값을 바꿨다고 경로가 바뀌지는 않는다. **두 WEB 에서 ./30-web.sh 를
#     다시 돌려야** nginx upstream 이 VIP 로 간다. 그 전까지는 direct 그대로다.
#
#   ※ VIP 가 아직 트래픽을 안 넘기는 상태에서 30-web.sh 를 돌리면 서비스가
#     통째로 502 가 된다 (30-web.sh 끝의 "전부 502 라면" 항목).
#
#     ★★ 그리고 **GSLB 는 그걸 못 잡는다.** 지금 헬스체크는 /health/web 이고
#       그건 nginx 의 return 200 이라 upstream 을 아예 안 탄다(20-aadc-web
#       .conf.template). TCP 체크면 더 말할 것도 없다. 즉 VIP 가 죽어 있어도
#       멤버는 계속 up 이고, 실사용자 트래픽만 100% 502 가 된다.
#       **조용히 망가진다** — 이게 이 전환에서 제일 위험한 지점이다.
#       확인은 사람이 해야 한다: WEB 에서 curl -si localhost/ | head -1.
#
#       /health/deep 은 반대로 was_pool(=l4 모드면 VIP)을 탄다. 헬스체크를
#       deep 으로 올린 뒤에는 VIP 장애가 곧 DC 이탈이 된다 (GSLB.md 남은작업 3).
#
#     순서는
#       1) 네트워크 팀이 VIP 를 잡는다
#       2) http://10.3.20.100:8000/l4test 가 초록 "VIP 경유 확인" 으로 뜬다
#       3) 그때 WEB 에서 30-web.sh 재실행
#     되돌리기는 이 값을 direct 로 바꾸고 30-web.sh 를 다시 돌리면 끝이다.
#
# ★ 2026-09-23 — DC-400 VIP 가 끝까지 붙었다 (당시 10.7.20.230, 09-24 현재 .100). WEB-DC2 에서
#   curl 로 3-way handshake 와 응답까지 확인했다. 남은 것은 두 가지다.
#     · (09-24 해소) DC-500 VIP 는 10.3.20.100 으로 확인했다
#     · **두 WEB 에서 30-web.sh 를 다시 돌려야** nginx 가 VIP 로 간다.
#       돌리기 전까지 WEB 은 여전히 WAS 직결이다 — tcpdump 에서
#       10.7.11.52 가 10.7.21.52:8000 을 직접 때리는 것으로 확인했다.
UPSTREAM_MODE="l4"

# ----- /health/deep 강제 200 (임시 진단 스위치) ------------------------------
#   no   정상. 앱의 /health/deep 을 그대로 프록시한다.
#   yes  nginx 가 rewrite 단계에서 200 을 바로 돌려준다. 앱도 DB 도 타지 않는다.
#
# ★ 2026-09-21 yes — DB writer 가 아직 없어 /health/deep 이 503
#   (writer_unreachable) 이고, 그 때문에 FortiADC 가 WEB 을 down 으로 보고
#   L7 가상 서버가 503 Server-unavailable 을 낸다. **웹 경로가 끝까지
#   소통하는지만** 먼저 확인하려고 켠다 (GSLB.md §0-3).
#
# ★★ 켜 두면 GSLB 가 이 DC 를 늘 정상으로 본다. C3~C8·DR 전환 등
#   failover 시나리오는 이 상태에서 **전부 무의미하다.** 확인이 끝나면
#   즉시 no 로 되돌리고 30-web.sh 를 다시 돌릴 것.
#
# ★ 2026-09-21 — no 로 되돌렸다. 웹 경로 소통은 확인됐고(§GSLB.md 0-3),
#   이제 진짜 /health/deep 을 봐야 DB 연결 작업을 검증할 수 있다.
#   지금 GSLB 헬스체크는 /health/web 이므로, deep 이 503 이어도 서비스는
#   끊기지 않는다. deep 이 200 이 된 뒤에 헬스체크를 deep 으로 올린다.
DEEP_FORCE_OK="no"

# via_l4 판정용 접두사 (SNAT된 L4 주소로 경유 DC를 식별)
L4_PREFIX_DC500="10.3.20."
L4_PREFIX_DC400="10.7.20."
# L4 우회(direct) 모드에서 앞 홉은 L4 가 아니라 WEB 이다. 그걸 구분하려고 둔다.
WEB_PREFIX_DC500="10.3.11."
WEB_PREFIX_DC400="10.7.11."

# ----- DMZ FortiADC (GSLB) — real_ip 신뢰 대상 / 헬스체크 출발지 -------------
# ★ 장비 한 대가 주소 하나를 쓰는 게 아니다 (2026-09-21 확인).
#   VM 목록에는 `.241` 뿐인데 WEB 에 실제 도착한 출발지는
#   10.3.10.240 / 10.3.10.242 / 10.7.10.240 이었다. `.241` 만 신뢰·허용해
#   두었더니 /health/deep · /health/local 이 403 이 됐고, FortiADC 는 WEB 을
#   down 으로 판정해 503(Server-unavailable)을 냈다. GSLB.md §0-3.
#   Viettel 에 정확한 출발지 목록을 확인 요청했고, 그 전까지 대역으로 잡는다.
#   (.240-.247 에는 FortiADC 외에 다른 장비가 없다)
DMZ_ADC_DC500="10.3.10.240/29"
DMZ_ADC_DC400="10.7.10.240/29"

# ----- 서비스 FQDN ----------------------------------------------------------
# ★ 2026-09-21 — 실제 GSLB Host 는 `www` 가 아니라 `test-web-gslb` 다.
#   우리는 GSLB-REQUEST 10번에서 www.niceci.cloud 를 요청했으나 Viettel 이
#   test-web-gslb.niceci.cloud 로 만들었고, 그것이 동작 중이다 (TTL 20).
#   www 는 여전히 NXDOMAIN. server_name 에 `_`(기본 서버)가 있어 지금도
#   요청은 처리되지만, 실제 이름을 적어 두어야 로그·검증 화면이 맞는다.
SERVICE_FQDN="test-web-gslb.niceci.cloud"
WEB1_FQDN="web1.niceci.cloud"      # WEB-DC1 고정
WEB2_FQDN="web2.niceci.cloud"      # WEB-DC2 고정

# ----- 진단 화면 / 헬스체크 접근 제어 ---------------------------------------
# 검증 화면(/), /api/db/, /checkvs/, /peer/ 는 DB writer 신원과 semi-sync 상태를
# 노출한다. WEB 은 인터넷에 열려 있으므로 관리 대역으로 한정한다.
# 공백으로 구분. nginx allow 문법(단일 IP 또는 CIDR)을 그대로 쓴다.
#
# ★ 현재 PoC 기간 한정으로 **전면 공개**다 (2026-09-20 결정).
#
#   앞단 DMZ FortiADC 가 XFF 를 아직 삽입하지 않아(회신 대기 4번) nginx 가 보는
#   주소는 고객 IP 가 아니라 FortiADC 자신(10.7.10.241 등)이다. 그래서 IP 목록에
#   사무실 주소를 적어도 맞지 않고, ADMIN_AUTH=off 와 겹쳐 검증 화면이 우리한테도
#   403 이 됐다. 앞단 주소를 목록에 넣는 방법은 쓰지 않았다 — 그 주소로 인터넷
#   전체가 들어오므로 노출 범위는 0.0.0.0/0 과 같은데 목록만 보면 제한된 것처럼
#   보여서, 나중에 이 파일을 읽는 사람이 틀리게 읽는다.
#
#   지금 공개되는 것: 검증 화면(/), /api/db/(writer 호스트명·server_id·semi-sync),
#   /checkvs/, /peer/. 내부 IP 체계가 그대로 보인다는 뜻이다.
#
#   되돌리기 — XFF 삽입이 적용되면 아래 한 줄로 바꾸고 30-web.sh 재실행:
#   ADMIN_ALLOW="39.124.10.233 106.247.244.250 10.3.0.0/24 10.7.0.0/24 10.3.255.0/24 127.0.0.1"
#   (지금 나가는 주소 확인: curl -s https://api.ipify.org / NAT 풀이라 바뀔 수 있다)
#
# ★ 2026-09-21 — "0.0.0.0/0" 에서 "all" 로 바꿨다. 0.0.0.0/0 은 IPv4 만
#   매칭해서 IPv6 로 들어오면 403 이 된다. nginx 의 allow all 은 두 계열을
#   모두 포함한다. 어차피 전면 공개라 의미는 같고, 구멍만 메운다.
ADMIN_ALLOW="all"

# 위 IP 목록과 **둘 중 하나만** 통과하면 된다 (nginx satisfy any).
# 앞단이 SNAT 를 하면 nginx 는 고객 IP 를 보지 못하므로 IP 목록이 안 맞는다.
# XFF 삽입이 적용되기 전까지는 이 계정이 유일하게 확실한 진입 수단이다.
ADMIN_USER="aadc"
ADMIN_PASS="delete_20261013_web"

# basic 인증 on/off. 계정과 .htpasswd 는 off 여도 그대로 만들어 두므로,
# 되돌릴 때는 이 값만 on 으로 바꾸고 30-web.sh 를 다시 돌리면 된다.
#
# ★ off 로 두면 진입 조건이 ADMIN_ALLOW **IP 목록 하나만** 남는다.
#   앞단(FortiGate / DMZ FortiADC)이 SNAT 를 하면 nginx 가 보는 주소는 고객
#   IP 가 아니라 앞단 장비 주소라, 목록에 사무실 IP 를 적어 두었어도 안 맞고
#   **암호창 대신 403** 이 나온다. 그때는 아래 둘 중 하나다.
#     · ADMIN_ALLOW 에 /health/web 의 client 값을 넣는다 (정상적인 방법)
#     · ADMIN_ALLOW="0.0.0.0/0"  — 검증 화면을 인터넷에 전면 공개한다
#   전면 공개는 DB writer 호스트명·semi-sync 상태·내부 IP 가 그대로 보인다는
#   뜻이다. PoC 기간 한정으로만 쓰고, 끝나면 on 으로 되돌린다.
ADMIN_AUTH="off"

# /health/deep 응답에는 writer 호스트명이 들어 있다. 이걸 봐야 하는 것은
# GSLB(DMZ FortiADC)와 모니터링뿐이다.
# ★ GSLB 주소를 빠뜨리면 헬스체크가 403 이 되고 GSLB 가 그 DC 를 뺀다.
#
# ★ WEB 두 대도 들어가야 한다 (2026-09-20 추가). 검증 화면의 `/peer/` 는 반대편
#   WEB 의 /health/deep 을 대신 물어보는데, 그 요청의 출발지는 **우리 WEB** 이다.
#   목록에 없으면 반대편 nginx 가 403 을 돌려주고, 화면에는 "반대편 DC 무응답"
#   으로 보인다. 실제로 겪었다 — 크롬 콘솔에 /peer/health/deep 403.
#
# 브라우저로 /health/deep 을 직접 열면 여전히 403 이다. 앞단을 거치면서 주소가
# 바뀌기 때문이고, 무엇으로 바뀌는지는 /health/web 의 client 값이 알려 준다.
# 진단 화면은 403 을 "실패"가 아니라 "권한 없음"으로 구분해 표시한다.
#
# ★ 2026-09-21 결정 — PoC 기간 **전면 공개**. IP 제한을 두지 않는다.
#
#   경위: FortiADC 의 실제 출발지가 .240 / .241 / .242 로 흩어져 있어 목록이
#   계속 어긋났다. 빠진 주소 하나가 /health/deep 403 → FortiADC 가 그 DC 를
#   down 판정 → L7 가상 서버 멤버 0개 → 503 으로 이어졌다 (GSLB.md §0-3).
#   주소 목록을 맞추는 방식 자체가 앞단 구성에 계속 끌려다니고, 폐기 예정
#   환경이라 제한을 유지할 실익이 없다고 판단했다. 진단 중 변수를 하나
#   줄이는 목적도 있다.
#
#   공개되는 것: /health/deep · /health/local 의 writer 호스트명, semi-sync
#   상태, degraded 여부. WEB 은 공인 IP 로 인터넷에 노출돼 있다.
#
#   되돌리기: 아래를 목록으로 바꾸고 install/30-web.sh 재실행.
#   운영 전환 시 예시 —
#   HEALTH_ALLOW="10.3.10.240/29 10.7.10.240/29 10.3.11.51 10.7.11.52 10.3.0.0/24 127.0.0.1"
HEALTH_ALLOW="all"

# ----- 애플리케이션 ---------------------------------------------------------
APP_PORT="8000"
APP_DIR="/opt/aadc"
APP_USER="aadc"
APP_VERSION="1.0.0"                # 카나리 배포 검증용 (8절). DC별로 다르게 둘 것

# ----- DB -------------------------------------------------------------------
DB_NAME="aadc"
DB_APP_USER="aadc_app"
DB_APP_PASS="delete_20261013_app"
DB_REPL_USER="repl"
DB_REPL_PASS="delete_20261013_repl"
DB_MON_USER="monitor"              # 알람 헬스체크용 (REPLICATION CLIENT)
DB_MON_PASS="delete_20261013_mon"
# 복제 심장박동 전용. ★ SUPER 가 없어야 한다 — 있으면 read_only=ON 인 BACKUP 에서도
# 쓰기가 성공해 GTID 가 갈라진다 (db/sql/02-grants.sql 주석 참조).
DB_HB_USER="aadc_hb"
DB_HB_PASS="delete_20261013_hb"
# 초기 적재 덤프 전용. repl 계정으로는 mysqldump 가 불가능하다(권한 부족).
DB_DUMP_USER="aadc_dump"
DB_DUMP_PASS="delete_20261013_dump"

# ----- DB 백엔드 ------------------------------------------------------------
#   mariadb  본설계. WAS → DB VIP 10.3.31.50 직결
#   sqlite   임시. DB 서버에 접근할 수 없는 동안 WAS 로컬 파일로 대신한다
#
# ★ sqlite 는 **공유 DB 가 아니다.** 두 WAS 가 서로 다른 데이터를 본다.
#   이 모드에서 검증되지 않는 것:
#     · /health/deep 의 writer 도달 확인 — 로컬 파일은 언제나 도달한다
#     · C8  DCI 단절 시 DC-400 자동 이탈 — 위 확인에 의존한다
#     · C3~C7 DB 전환, semi-sync / RPO / 복제 지연 전부
#   DB 서버가 열리면 mariadb 로 되돌리고 위 항목을 다시 돌린다.
#
# ★ 2026-09-21 — mariadb 로 되돌렸다. DB 서버를 web 대역으로 잠시 옮겨
#   MariaDB 를 설치하고 되돌려 놓았고, WAS 에서 10.3.31.51:3306 도달을
#   확인했다. sqlite 는 두 WAS 가 서로 다른 데이터를 보므로, 실DB 가
#   닿는 이상 쓸 이유가 없다. 다만 아직 단일 노드라 복제·전환은 미검증이다.
DB_MODE="mariadb"
SQLITE_PATH="/opt/aadc/data/aadc.sqlite"

# 앱이 붙을 DB 주소. 평시 VIP, DR 전환 1단계에서 DB_DR_IP 로 바뀐다 (dr/).
# ★ 2026-09-21 임시 — VIP 가 아니라 DB-MASTER 실주소를 직접 본다.
#
#   DB 서버를 web 대역으로 잠시 옮겨 MariaDB 를 설치한 뒤 되돌렸는데,
#   임시 주소에서는 10-db.sh 가 keepalived 를 **의도적으로 건너뛴다**
#   (unicast_src_ip 불일치·VIP 를 엉뚱한 서브넷에 올림·증인 GW 도달 불가 —
#   셋 다 "켜져 있는데 동작 안 함"이 되므로). 그래서 VIP 10.3.31.50 이 아직
#   없고, 앱이 그 주소를 보면 writer_unreachable 로 503 이 난다.
#
#   되돌리기: DB-BACKUP(10.3.31.53) VM 을 받고 정식 주소에서 10-db.sh 를
#   다시 돌려 keepalived 가 VIP 를 잡으면 아래를 ${DB_VIP} 로 복귀.
#   그 전에 증인 게이트웨이 ${GW_DC_DB} 가 ICMP 에 응답하는지 확인할 것 —
#   응답이 없으면 chk_db 가 늘 FAULT 라 VIP 가 영영 안 올라온다.
DB_APP_TARGET="${DB_MASTER_IP}"
DB_PORT="3306"

# 중간 프록시가 없으므로 이 두 값이 DCI 구간을 방어하는 유일한 장치다
# (AADC-POC.md 3-4절). DC-400 WAS 는 평시에도 모든 쿼리가 DCI 를 건넌다.
# 회신 1번(peer-routing RTT) 이 오면 재조정할 것.
# ※ 늘리면 nginx 의 /health/deep proxy_read_timeout(6s) 도 같이 올려야 한다.
DB_CONNECT_TIMEOUT="2"
DB_READ_TIMEOUT="3"

# ----- keepalived -----------------------------------------------------------
# keepalived 를 구성할 것인가. 10-db.sh 가 이 값을 본다.
#
# ★ 2026-09-21 no. 전제가 둘 다 아직 없다 —
#     · DB-BACKUP(10.3.31.53) VM 이 없다. 단일 노드로 켜면 의미가 없다
#     · 증인 게이트웨이 GW_DC_DB(10.3.31.254)의 ICMP 응답 여부가 미확인이다.
#       응답이 없으면 chk_db 가 늘 FAULT 라 VIP 가 영영 안 올라온다
#   임시 주소 분기와 같은 이유다: 켜 봐야 "켜져 있는데 동작 안 함"이 되고,
#   그 상태는 에러로 죽지 않아서 나중에 원인 분리가 어려워진다.
#   둘 다 갖춰지면 yes 로 바꾸고 10-db.sh 를 다시 돌린다.
KEEPALIVED_SETUP="no"

VRRP_ROUTER_ID="51"
VRRP_IFACE="ens192"
# ★ VRRP 는 8자 제한이라 여기만 짧다. 넘으면 keepalived 가 조용히 잘라서
#   양쪽 노드의 인증이 어긋나도 로그에 이유가 안 남는다.
VRRP_AUTH_PASS="del1013!"

# ----- 알람 (7-③절) ---------------------------------------------------------
# 미설정이면 logger(syslog)로만 남는다.
ALARM_WEBHOOK_URL=""
ALARM_MAIL_TO=""
