# =============================================================================
# AADC PoC 트랙 C — 공통 파라미터  (PoC 실값)
# =============================================================================
# 모든 설치/검증 스크립트가 이 파일을 source 한다.
#
# <<TBD>> 로 표시된 값은 AADC-POC.md 13-2절 "회신 대기" 항목이다.
# 값이 들어오기 전에는 해당 계층을 확정으로 취급하지 않는다.
#
# -----------------------------------------------------------------------------
# WHY THIS FILE IS COMMITTED AS-IS, WITH REAL VALUES
#
#   This is a throwaway PoC environment that will be torn down. Every credential
#   below is named `delete_20261013_*` so that the name itself states what it is:
#   a temporary secret that dies with the environment on 2026-10-13. Nothing here
#   is reused in production, and the environment it unlocks will not exist.
#
#   Keeping the real values in the bundle is a deliberate trade: the servers are
#   reachable only through a VM console (no inbound SSH, no jump host), so every
#   value typed by hand is a value typed wrong. We would rather ship the file.
#
#   DO NOT carry this file forward. If this PoC turns into anything permanent,
#   regenerate every credential and remove config.env from version control
#   (the .gitignore comment says the same thing).
#
#   On teardown, drop the accounts outright:
#     DROP USER 'aadc_app'@'10.3.21.%', 'aadc_app'@'10.7.21.%',
#               'repl'@'10.3.31.%', 'repl'@'10.7.31.%',
#               'monitor'@'127.0.0.1', 'monitor'@'10.3.%', 'monitor'@'10.7.%',
#               'aadc_hb'@'127.0.0.1', 'aadc_hb'@'localhost',
#               'aadc_dump'@'localhost';
# -----------------------------------------------------------------------------
# =============================================================================

# ----- 이 호스트가 무엇인가 -------------------------------------------------
# ★ 서버마다 이 두 줄만 바꾸면 된다.
# WEB-DC1 | WEB-DC2 | WAS-APP1-500 | WAS-DC2 | DB-MASTER | DB-BACKUP | DB-DR
AADC_ROLE="WAS-APP1-500"
# DC-500 | DC-400
AADC_DC="DC-500"

# ----- 서버 IP (AADC-POC.md 2-1절, 단일 NIC) --------------------------------
WEB_DC1_IP="10.3.11.51"
WEB_DC2_IP="10.7.11.52"
WAS_DC500_IP="10.3.21.51"          # WAS-APP1-500
WAS_DC400_IP="10.7.21.52"          # WAS-DC2  (IP 할당 필요)

DB_VIP="10.3.31.50"                # keepalived VIP (DC-500 내부)
DB_MASTER_IP="10.3.31.51"
DB_BACKUP_IP="10.3.31.53"          # 신규 VM 필요
DB_DR_IP="10.7.31.52"              # dr-db 로 이전 필요 (현재 10.3.31.52)

# ----- 게이트웨이 (keepalived 타이브레이커 = 증인) --------------------------
GW_DC_DB="10.3.31.254"
GW_DC_APP="10.3.21.254"
GW_DR_APP="10.7.21.254"
GW_DC_WEB="10.3.11.254"
GW_DR_WEB="10.7.11.254"

# ----- 내부 L4 FortiADC VIP  <<TBD: 회신 4번>> ------------------------------
# 회신 전에는 아래 값으로 구성만 해두고 실트래픽을 붙이지 않는다.
DC500_L4_VIP="10.3.20.100"         # <<TBD>>
DC400_L4_VIP="10.7.20.100"         # <<TBD>>
# backup(교차) 멤버 점검 전용 VS — AADC-POC.md 3-3절
DC500_CHECK_VS_VIP="10.3.20.101"   # <<TBD>>  멤버: 10.7.21.52 만
DC400_CHECK_VS_VIP="10.7.20.101"   # <<TBD>>  멤버: 10.3.21.51 만
L4_PORT="8000"

# via_l4 판정용 접두사 (SNAT된 L4 주소로 경유 DC를 식별)
L4_PREFIX_DC500="10.3.20."
L4_PREFIX_DC400="10.7.20."

# ----- DMZ FortiADC (GSLB) — real_ip 신뢰 대상 ------------------------------
DMZ_ADC_DC500="10.3.10.241"
DMZ_ADC_DC400="10.7.10.241"

# ----- 서비스 FQDN ----------------------------------------------------------
SERVICE_FQDN="www.niceci.cloud"
WEB1_FQDN="web1.niceci.cloud"      # WEB-DC1 고정
WEB2_FQDN="web2.niceci.cloud"      # WEB-DC2 고정

# ----- 진단 화면 / 헬스체크 접근 제어 ---------------------------------------
# 검증 화면(/), /api/db/, /checkvs/, /peer/ 는 DB writer 신원과 semi-sync 상태를
# 노출한다. WEB 은 인터넷에 열려 있으므로 관리 대역으로 한정한다.
# 공백으로 구분. nginx allow 문법(단일 IP 또는 CIDR)을 그대로 쓴다.
ADMIN_ALLOW="10.3.0.0/24 10.7.0.0/24 10.3.255.0/24 127.0.0.1"

# /health/deep 응답에는 writer 호스트명이 들어 있다. 이걸 봐야 하는 것은
# GSLB(DMZ FortiADC)와 모니터링뿐이다.
# ★ GSLB 주소를 빠뜨리면 헬스체크가 403 이 되고 GSLB 가 그 DC 를 뺀다.
HEALTH_ALLOW="10.3.10.241 10.7.10.241 10.3.0.0/24 127.0.0.1"

# ----- 애플리케이션 ---------------------------------------------------------
APP_PORT="8000"
APP_DIR="/opt/aadc"
APP_USER="aadc"
APP_VERSION="1.0.0"                # 카나리 배포 검증용 (8절). DC별로 다르게 둘 것

# ----- DB -------------------------------------------------------------------
DB_NAME="aadc"
DB_APP_USER="aadc_app"
DB_APP_PASS="delete_20261013_app"
DB_REPL_USER="repl"
DB_REPL_PASS="delete_20261013_repl"
DB_MON_USER="monitor"              # 알람 헬스체크용 (REPLICATION CLIENT)
DB_MON_PASS="delete_20261013_mon"
# 복제 심장박동 전용. ★ SUPER 가 없어야 한다 — 있으면 read_only=ON 인 BACKUP 에서도
# 쓰기가 성공해 GTID 가 갈라진다 (db/sql/02-grants.sql 주석 참조).
DB_HB_USER="aadc_hb"
DB_HB_PASS="delete_20261013_hb"
# 초기 적재 덤프 전용. repl 계정으로는 mysqldump 가 불가능하다(권한 부족).
DB_DUMP_USER="aadc_dump"
DB_DUMP_PASS="delete_20261013_dump"

# 앱이 붙을 DB 주소. 평시 VIP, DR 전환 1단계에서 DB_DR_IP 로 바뀐다 (dr/).
DB_APP_TARGET="${DB_VIP}"
DB_PORT="3306"

# 중간 프록시가 없으므로 이 두 값이 DCI 구간을 방어하는 유일한 장치다
# (AADC-POC.md 3-4절). DC-400 WAS 는 평시에도 모든 쿼리가 DCI 를 건넌다.
# 회신 1번(peer-routing RTT) 이 오면 재조정할 것.
# ※ 늘리면 nginx 의 /health/deep proxy_read_timeout(6s) 도 같이 올려야 한다.
DB_CONNECT_TIMEOUT="2"
DB_READ_TIMEOUT="3"

# ----- keepalived -----------------------------------------------------------
VRRP_ROUTER_ID="51"
VRRP_IFACE="ens192"
# ★ VRRP 는 8자 제한이라 여기만 짧다. 넘으면 keepalived 가 조용히 잘라서
#   양쪽 노드의 인증이 어긋나도 로그에 이유가 안 남는다.
VRRP_AUTH_PASS="del1013!"

# ----- 알람 (7-③절) ---------------------------------------------------------
# 미설정이면 logger(syslog)로만 남는다.
ALARM_WEBHOOK_URL=""
ALARM_MAIL_TO=""
