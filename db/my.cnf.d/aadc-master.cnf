# /etc/my.cnf.d/aadc-master.cnf — DB-MASTER (10.3.31.51, DC-500)
[mysqld]
server_id = 51
report_host = DB-MASTER

# ----- 안전장치 ⑤ : semi-sync (DC-500 내부, RPO 0) --------------------------
rpl_semi_sync_master_enabled = ON
# BACKUP 이 죽었을 때 master 가 무한 대기하지 않고 async 로 강등된다.
# 이것이 없으면 backup 장애가 master 정지로 번진다.
rpl_semi_sync_master_timeout = 1000          # 1초
rpl_semi_sync_master_wait_point = AFTER_SYNC
# OFF 로 둔다. ON 이면 슬레이브가 0 이 된 직후에도 커밋마다 타임아웃(1초)을
# 기다렸다가 강등된다. 안전장치 ⑤ 의 취지는 "backup 장애가 master 정지로
# 번지지 않게" 하는 것이므로, 즉시 async 로 떨어지는 쪽이 맞다.
# 강등되면 알람 ③ 이 즉시 울린다 — 조용히 RPO 가 깨지는 일은 없다.
rpl_semi_sync_master_wait_no_slave = OFF
# 역할 교대(nopreempt 로 .51 ↔ .53 가 번갈아 감)에 대비해 slave 측도 켜 둔다.
rpl_semi_sync_slave_enabled  = ON
