# /etc/aadc/was.env  — systemd EnvironmentFile
# WAS-APP1-500 (DC-500) 기준. WAS-DC2는 AADC_DC=DC-400 으로만 바꾸면 된다.

AADC_DC=DC-500
AADC_NODE=WAS-APP1-500
AADC_APP_VERSION=1.0.0

AADC_L4_PREFIX_DC500=10.3.20.
AADC_L4_PREFIX_DC400=10.7.20.
# L4 우회(direct) 모드 판정용
AADC_WEB_PREFIX_DC500=10.3.11.
AADC_WEB_PREFIX_DC400=10.7.11.

# DB VIP 에 직접 붙는다 (AADC-POC.md 3-4절).
# DR 전환 1단계에서 이 값을 10.7.31.52 로 바꾸고 앱을 재시작한다.
#   dr/dr-failover-step1-switch-writer.sh
AADC_DB_HOST=10.3.31.50
AADC_DB_PORT=3306
AADC_DB_USER=aadc_app
AADC_DB_PASS=CHANGE_ME_app
AADC_DB_NAME=aadc
# 중간 프록시가 없으므로 이 두 값이 DCI 구간을 방어하는 유일한 장치다.
# DC-400 WAS 는 평시에도 모든 쿼리가 DCI 를 건넌다 — 회신 1번(RTT) 후 재조정할 것.
AADC_DB_CONNECT_TIMEOUT=2
AADC_DB_READ_TIMEOUT=3

# /health/deep 의 writer 확인 방식
#   select : SELECT 1 + @@global.read_only=0 확인   (기본)
#   write  : 실제 INSERT 까지 수행                   (엄격, 부하 유의)
AADC_DEEP_WRITER_PROBE=select
# deep/local 결과 캐시 (초). GSLB 3초 주기 + L4 2초 주기의 중복 질의를 흡수한다.
AADC_HEALTH_CACHE_TTL=1.0
